{
  "manifest_version": 3,
  "name": "Incognito Router",
  "version": "2.0",
  "description": "Open configured URLs in Incognito/InPrivate mode.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}